@page "/create-listing"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Campus_Cart_Student_Marketplace.Models
@using Campus_Cart_Student_Marketplace.Services
@attribute [Authorize]
@inject UserManager<ApplicationUser> UserManager
@inject HttpContext HttpContext
@inject ListingService ListingService
@inject NavigationManager NavigationManager
@inject ILogger<CreateListing> Logger

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Create New Listing</h3>
                </div>
                <div class="card-body p-5">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            @errorMessage
                            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
                        </div>
                    }

                    @if (!isSellerAccount)
                    {
                        <div class="alert alert-warning">
                            <strong>Note:</strong> You need a seller account to create listings.
                            <a href="/account-settings">Upgrade to seller account</a>
                        </div>
                    }
                    else
                    {
                        <EditForm Model="listingModel" OnValidSubmit="HandleCreateListing">
                            <DataAnnotationsValidator />

                            <div class="mb-3">
                                <label for="title" class="form-label">Item Title *</label>
                                <InputText id="title" class="form-control" @bind-Value="listingModel.Title" 
                                    placeholder="e.g., Psychology Textbook - 3rd Edition" />
                                <ValidationMessage For="() => listingModel.Title" class="text-danger" />
                            </div>

                            <div class="mb-3">
                                <label for="category" class="form-label">Category *</label>
                                <InputSelect id="category" class="form-control" @bind-Value="listingModel.CategoryId">
                                    <option value="">-- Select a category --</option>
                                    @foreach (var category in categories)
                                    {
                                        <option value="@category.CategoryId">@category.Name</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="() => listingModel.CategoryId" class="text-danger" />
                            </div>

                            <div class="mb-3">
                                <label for="price" class="form-label">Price ($) *</label>
                                <InputNumber id="price" class="form-control" @bind-Value="listingModel.Price" 
                                    placeholder="0.00" step="0.01" />
                                <ValidationMessage For="() => listingModel.Price" class="text-danger" />
                            </div>

                            <div class="mb-3">
                                <label for="condition" class="form-label">Condition *</label>
                                <InputSelect id="condition" class="form-control" @bind-Value="listingModel.Condition">
                                    <option value="">-- Select condition --</option>
                                    <option value="New">New</option>
                                    <option value="Like New">Like New</option>
                                    <option value="Good">Good</option>
                                    <option value="Fair">Fair</option>
                                    <option value="Poor">Poor</option>
                                </InputSelect>
                                <ValidationMessage For="() => listingModel.Condition" class="text-danger" />
                            </div>

                            <div class="mb-3">
                                <label for="description" class="form-label">Description *</label>
                                <InputTextArea id="description" class="form-control" @bind-Value="listingModel.Description" 
                                    placeholder="Describe the item in detail..." rows="5"></InputTextArea>
                                <ValidationMessage For="() => listingModel.Description" class="text-danger" />
                                <small class="form-text text-muted">Include condition details, any defects, and why you're selling</small>
                            </div>

                            <div class="mb-3">
                                <label for="location" class="form-label">Location/Campus Area (Optional)</label>
                                <InputText id="location" class="form-control" @bind-Value="listingModel.Location" 
                                    placeholder="e.g., Student Center, Library, Dorm A" />
                            </div>

                            <div class="mb-3">
                                <label for="imageUrl" class="form-label">Image URL (Optional)</label>
                                <InputText id="imageUrl" class="form-control" @bind-Value="listingModel.ImageUrl" 
                                    placeholder="https://example.com/image.jpg" />
                                <small class="form-text text-muted">Provide a direct URL to an image of the item</small>
                            </div>

                            @if (!string.IsNullOrEmpty(listingModel.ImageUrl))
                            {
                                <div class="mb-3">
                                    <img src="@listingModel.ImageUrl" alt="Preview" class="img-thumbnail" style="max-width: 200px;" />
                                </div>
                            }

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary btn-lg" disabled="@isSubmitting">
                                    @if (isSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        <span>Creating Listing...</span>
                                    }
                                    else
                                    {
                                        <span>Create Listing</span>
                                    }
                                </button>
                            </div>
                        </EditForm>

                        <div class="text-center mt-3">
                            <a href="/my-listings" class="text-decoration-none">Back to My Listings</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private ListingModel listingModel = new();
    private List<Category> categories = new();
    private ApplicationUser? currentUser;
    private bool isSellerAccount = false;
    private bool isSubmitting = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            currentUser = await UserManager.GetUserAsync(HttpContext.User);
            
            if (currentUser == null)
            {
                NavigationManager.NavigateTo("/login");
                return;
            }

            isSellerAccount = currentUser.IsSellerAccount;
            categories = await ListingService.GetCategoriesAsync();
            Logger.LogInformation($"User {currentUser.Email} accessed create listing page");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading categories");
            errorMessage = "Error loading categories. Please try again.";
        }
    }

    private async Task HandleCreateListing()
    {
        try
        {
            if (currentUser == null)
            {
                NavigationManager.NavigateTo("/login");
                return;
            }

            isSubmitting = true;
            errorMessage = null;

            var listing = new Listing
            {
                SellerId = currentUser.Id,
                Title = listingModel.Title,
                Description = listingModel.Description,
                Price = listingModel.Price,
                CategoryId = listingModel.CategoryId,
                Condition = listingModel.Condition ?? "Good",
                Location = listingModel.Location,
                ImageUrl = listingModel.ImageUrl,
                IsAvailable = true
            };

            var createdListing = await ListingService.CreateListingAsync(listing);
            Logger.LogInformation($"Listing {createdListing.ListingId} created by {currentUser.Email}");

            NavigationManager.NavigateTo($"/listing/{createdListing.ListingId}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error creating listing");
            errorMessage = $"Error creating listing: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    public class ListingModel
    {
        [Required(ErrorMessage = "Title is required")]
        [StringLength(200, MinimumLength = 5, ErrorMessage = "Title must be between 5 and 200 characters")]
        public string Title { get; set; } = "";

        [Required(ErrorMessage = "Description is required")]
        [StringLength(5000, MinimumLength = 20, ErrorMessage = "Description must be between 20 and 5000 characters")]
        public string Description { get; set; } = "";

        [Required(ErrorMessage = "Price is required")]
        [Range(0.01, 10000, ErrorMessage = "Price must be between $0.01 and $10,000")]
        public decimal Price { get; set; }

        [Required(ErrorMessage = "Category is required")]
        [Range(1, int.MaxValue, ErrorMessage = "Please select a valid category")]
        public int CategoryId { get; set; }

        [Required(ErrorMessage = "Condition is required")]
        public string? Condition { get; set; }

        public string? Location { get; set; }

        [Url(ErrorMessage = "Image URL must be a valid URL")]
        public string? ImageUrl { get; set; }
    }
}
