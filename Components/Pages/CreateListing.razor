@page "/create-listing"

@using CampusCart.Models
@using CampusCart.Services

@inject ItemService ItemService
@inject NavigationManager Navigation

<h3>Create Listing</h3>

<EditForm Model="item"
          OnValidSubmit="SaveItem"
          FormName="CreateItem">

           <DataAnnotationsValidator />
    <ValidationSummary />


    <div class="mb-3">
        <label>Title</label>
        <InputText class="form-control" @bind-Value="item.Title" />
    </div>

    <div class="mb-3">
        <label>Description</label>
        <InputText class="form-control" @bind-Value="item.Description" />
    </div>

    <div class="mb-3">
        <label>Price</label>
        <InputNumber class="form-control" @bind-Value="item.Price" />
    </div>

    <div class="mb-3">
        <label>Category</label>
        <InputText class="form-control" @bind-Value="item.Category" />
    </div>

    <div class="mb-3">
        <label>Image URL</label>
        <InputText class="form-control" @bind-Value="item.ImageUrl" />
    </div>

    <button class="btn btn-primary" type="submit">
        Save Listing
    </button>

</EditForm>

@code {

    private Item item = new();

    private void SaveItem()
    {
        ItemService.AddItem(item);

        Navigation.NavigateTo("/marketplace");
    }

}