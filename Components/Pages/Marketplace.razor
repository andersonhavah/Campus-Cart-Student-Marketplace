@page "/marketplace"
@using Campus_Cart_Student_Marketplace.Models
@using Campus_Cart_Student_Marketplace.Services
@inject ListingService ListingService
@inject NavigationManager NavigationManager
@inject ILogger<Marketplace> Logger

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1>Campus Cart Marketplace</h1>
            <p class="text-muted">Browse and find great deals from fellow students</p>
        </div>
    </div>

    <!-- Search and Filter -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="input-group">
                <input type="text" class="form-control" placeholder="Search listings..." 
                    @bind="searchTerm" @onkeyup="OnSearchKeyUp" />
                <button class="btn btn-primary" @onclick="Search">🔍 Search</button>
            </div>
        </div>
        <div class="col-md-3">
            <select class="form-select" @onchange="OnCategoryChangeHandler">
                <option value="">All Categories</option>
                @foreach (var category in categories)
                {
                    <option value="@category.CategoryId">@category.Name</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <select class="form-select" @onchange="OnSortChangeHandler">
                <option value="newest">Newest First</option>
                <option value="price-low">Price: Low to High</option>
                <option value="price-high">Price: High to Low</option>
                <option value="popular">Most Popular</option>
            </select>
        </div>
    </div>

    <!-- Listings Grid -->
    @if (listings == null)
    {
        <div class="text-center">
            <div class="spinner-border" role="status"></div>
            <p>Loading listings...</p>
        </div>
    }
    else if (listings.Count == 0)
    {
        <div class="alert alert-info text-center">
            <h5>No listings found</h5>
            <p>Try adjusting your search or filters</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var listing in listings)
            {
                <div class="col-md-4 col-lg-3 mb-4">
                    <div class="card h-100 shadow-sm listing-card" style="cursor: pointer; transition: transform 0.2s;" 
                        @onclick="() => ViewListing(listing.ListingId)">
                        
                        <!-- Image -->
                        <div style="height: 200px; overflow: hidden; background-color: #f0f0f0;">
                            @if (!string.IsNullOrEmpty(listing.ImageUrl))
                            {
                                <img src="@listing.ImageUrl" class="card-img-top" alt="@listing.Title" 
                                    style="height: 100%; width: 100%; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center h-100">
                                    <span class="text-muted">No Image</span>
                                </div>
                            }
                        </div>

                        <!-- Card Body -->
                        <div class="card-body d-flex flex-column">
                            <h6 class="card-title">@listing.Title</h6>
                            
                            <p class="card-text text-muted small">
                                <span class="badge bg-secondary">@listing.Category?.Name</span>
                                <span class="badge bg-light text-dark">@listing.Condition</span>
                            </p>

                            <p class="text-muted small mb-2">
                                📍 @(string.IsNullOrEmpty(listing.Location) ? "Location TBA" : listing.Location)
                            </p>

                            <div class="mt-auto">
                                <h5 class="text-primary mb-2">$@listing.Price.ToString("F2")</h5>
                                
                                <div class="d-flex justify-content-between align-items-center">
                                    <small class="text-muted">👤 @listing.Seller?.StoreName</small>
                                    <small class="text-muted">👁️ @listing.ViewCount</small>
                                </div>
                            </div>
                        </div>

                        <!-- Card Footer -->
                        <div class="card-footer bg-white border-top-0">
                            <button class="btn btn-sm btn-outline-primary w-100" 
                                @onclick:stopPropagation 
                                @onclick="() => NavigateToListing(listing.ListingId)">
                                View Details
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .listing-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 15px rgba(0,0,0,0.2) !important;
    }
</style>

@code {
    private List<Listing>? listings;
    private List<Category> categories = new();
    private string searchTerm = "";
    private string selectedCategoryId = "";
    private string sortBy = "newest";
    private int pageNumber = 1;
    private int pageSize = 12;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            categories = await ListingService.GetCategoriesAsync();
            await LoadListings();
            Logger.LogInformation("Marketplace page loaded");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading marketplace");
            listings = new List<Listing>();
        }
    }

    private async Task LoadListings()
    {
        try
        {
            int? categoryId = string.IsNullOrEmpty(selectedCategoryId) ? null : int.Parse(selectedCategoryId);
            string? search = string.IsNullOrEmpty(searchTerm) ? null : searchTerm;

            listings = await ListingService.GetListingsAsync(categoryId, search, pageNumber, pageSize);

            // Apply sorting
            listings = sortBy switch
            {
                "price-low" => listings.OrderBy(l => l.Price).ToList(),
                "price-high" => listings.OrderByDescending(l => l.Price).ToList(),
                "popular" => listings.OrderByDescending(l => l.ViewCount).ToList(),
                _ => listings.OrderByDescending(l => l.CreatedAt).ToList()
            };
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading listings");
            listings = new List<Listing>();
        }
    }

    private async Task Search()
    {
        pageNumber = 1;
        await LoadListings();
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Search();
        }
    }

    private async Task OnCategoryChangeHandler(ChangeEventArgs e)
    {
        selectedCategoryId = e.Value?.ToString() ?? "";
        pageNumber = 1;
        await LoadListings();
    }

    private async Task OnSortChangeHandler(ChangeEventArgs e)
    {
        sortBy = e.Value?.ToString() ?? "newest";
        pageNumber = 1;
        await LoadListings();
    }

    private void ViewListing(int listingId)
    {
        NavigateToListing(listingId);
    }

    private void NavigateToListing(int listingId)
    {
        NavigationManager.NavigateTo($"/listing/{listingId}");
    }
}
