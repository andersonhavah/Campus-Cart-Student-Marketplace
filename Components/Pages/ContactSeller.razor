@page "/contact-seller/{ItemId:int}"
@using Campus_Cart_Student_Marketplace.Models
@using Campus_Cart_Student_Marketplace.Services
@inject MessageService MessageService
@inject ItemService ItemService
@inject NavigationManager NavigationManager

<div class="container my-5" style="max-width: 650px;">
    <div class="card p-4 shadow-sm border-0 rounded-3 bg-white">
        <h3 class="fw-bold text-dark mb-3"><i class="bi bi-envelope me-2"></i>Secure Seller Inquiry</h3>
        <hr class="text-muted mb-4" />

        @if (targetItem == null)
        {
            <div class="alert alert-danger rounded-3">
                Error: The requested listing target item record could not be fetched.
            </div>
        }
        else
        {
            <div class="d-flex align-items-center p-3 mb-4 bg-light rounded-3 border">
                <div class="flex-grow-1">
                    <h6 class="fw-bold mb-0 text-dark">@targetItem.Title</h6>
                    <span class="text-success fw-bold small">$@((targetItem.Price / 1000.00m).ToString("N2"))</span>
                </div>
            </div>

            <EditForm Model="messageModel" OnValidSubmit="ExecuteMessageSubmission">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label fw-bold text-secondary">Your Message Content</label>
                    <InputTextArea class="form-control border-2 p-3 rounded-3" rows="5"
                                   @bind-Value="messageModel.Content" />
                    <ValidationMessage For="@(() => messageModel.Content)" class="text-danger small mt-1" />
                </div>

                @if (displaySuccessPrompt)
                {
                    <div class="alert alert-success rounded-3 small mb-3">
                        Inquiry transmitted successfully!
                    </div>
                }

                <div class="d-flex gap-3 mt-4">
                    <button type="submit" class="btn btn-primary px-4 py-2 fw-bold shadow-sm rounded-3 flex-grow-1"
                            disabled="@displaySuccessPrompt">
                        Dispatch Message
                    </button>
                    <button type="button" class="btn btn-outline-secondary px-4 py-2 fw-bold rounded-3"
                            @onclick="ReturnToCatalog">
                        Cancel
                    </button>
                </div>
            </EditForm>
        }
    </div>
</div>

@code {
    [Parameter] public int ItemId { get; set; }

    private Item? targetItem;
    private Message messageModel = new();
    private bool displaySuccessPrompt = false;

    protected override async Task OnInitializedAsync()
    {
        targetItem = await ItemService.GetItemByIdAsync(ItemId);

        if (targetItem != null)
        {
            messageModel.ItemId = ItemId;
            messageModel.SenderUserId = "mock-buyer-555";
            messageModel.ReceiverUserId = targetItem.SellerId;
        }
    }

    private void ExecuteMessageSubmission()
    {
        displaySuccessPrompt = true;
    }

    private void ReturnToCatalog()
    {
        NavigationManager.NavigateTo("/marketplace");
    }
}