@page "/marketplace"
@page "/marketplace/{CategoryId:int}"
@using Campus_Cart_Student_Marketplace.Models
@using Campus_Cart_Student_Marketplace.Services
@inject ItemService ItemService
@inject CartService CartService
@inject NavigationManager NavigationManager

<div class="container my-4">
    <div class="row g-3 mb-4 align-items-center">
        <div class="col-md-6">
            <div class="input-group shadow-sm rounded">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" class="form-control border-start-0 ps-0"
                       placeholder="Search textbooks, chairs, electronics..." @bind-value="searchTerm"
                       @bind-value:event="oninput" @onkeyup="HandleSearch" />
            </div>
        </div>
        <div class="col-md-6 text-md-end">
            <span class="text-muted me-2 small">Filter Feed:</span>
            <div class="btn-group shadow-sm" role="group">
                <button class="btn btn-outline-primary btn-sm @(CategoryId == null ? "active" : "")"
                        @onclick="() => FilterByCategory(null)">All</button>
                <button class="btn btn-outline-primary btn-sm @(CategoryId == 1 ? "active" : "")"
                        @onclick="() => FilterByCategory(1)">Furniture</button>
                <button class="btn btn-outline-primary btn-sm @(CategoryId == 2 ? "active" : "")"
                        @onclick="() => FilterByCategory(2)">Appliances</button>
                <button class="btn btn-outline-primary btn-sm @(CategoryId == 3 ? "active" : "")"
                        @onclick="() => FilterByCategory(3)">Electronics</button>
                <button class="btn btn-outline-primary btn-sm @(CategoryId == 4 ? "active" : "")"
                        @onclick="() => FilterByCategory(4)">Books</button>
            </div>
        </div>
    </div>

    @if (!filteredItems.Any())
    {
        <div class="text-center py-5 bg-white rounded shadow-sm border">
            <i class="bi bi-patch-question text-muted" style="font-size: 3rem;"></i>
            <h4 class="fw-bold text-secondary mt-3">No campus deals found</h4>
            <p class="text-muted">Try modifying your search term keywords or selecting a alternative category.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var item in filteredItems)
            {
                <div class="col">
                    <div
                        class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden position-relative bg-white transition-card">
                        <span class="badge bg-dark position-absolute top-0 end-0 m-2 shadow-sm fs-7">@item.Condition</span>

                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "images/placeholder.png" : item.ImageUrl)"
                             class="card-img-top" alt="@item.Title" style="height: 180px; object-fit: cover;" />

                        <div class="card-body d-flex flex-column p-3">
                            <h6 class="card-title fw-bold text-dark mb-1 text-truncate">@item.Title</h6>
                            <p class="card-text text-muted small text-truncate-2 flex-grow-1 mb-2">@item.Description</p>

                            <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top">
                                <span class="fs-5 fw-bold text-success">$@((item.Price / 1000.00m).ToString("N2"))</span>
                                <div class="btn-group gap-1">
                                    <button class="btn btn-sm btn-outline-secondary rounded"
                                            @onclick="() => ViewDetails(item.Id)">
                                        Details
                                    </button>
                                    <button class="btn btn-sm btn-primary rounded px-2" @onclick="() => AddToBasket(item)">
                                        <i class="bi bi-cart-plus"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public int? CategoryId { get; set; }

    private List<Item> allItems = new();
    private List<Item> filteredItems = new();
    private string searchTerm = string.Empty;

    // Fixed Lifecycle Handler Link (CS0111 Remediation Node)
    protected override async Task OnParametersSetAsync()
    {
        LoadMarketplaceFeed();
        await Task.CompletedTask;
    }

    private void LoadMarketplaceFeed()
    {
        // 1. Core catalog data extraction routing
        allItems = ItemService.GetItems() ?? new List<Item>();

        // 2. Structural evaluation across Category criteria metrics
        if (CategoryId.HasValue && CategoryId.Value > 0)
        {
            filteredItems = allItems.Where(i => i.CategoryId == CategoryId.Value).ToList();
        }
        else
        {
            filteredItems = allItems.ToList();
        }

        // 3. Sequential evaluation across input keyword search variables
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var cleanedTerm = searchTerm.Trim().ToLower();
            filteredItems = filteredItems.Where(i =>
                i.Title.ToLower().Contains(cleanedTerm) ||
                i.Description.ToLower().Contains(cleanedTerm)).ToList();
        }
    }

    private void HandleSearch()
    {
        LoadMarketplaceFeed();
    }

    private void FilterByCategory(int? selectedCategoryId)
    {
        if (selectedCategoryId.HasValue)
        {
            NavigationManager.NavigateTo($"/marketplace/{selectedCategoryId.Value}");
        }
        else
        {
            NavigationManager.NavigateTo("/marketplace");
        }
    }

    private void AddToBasket(Item selectedItem)
    {
        CartService.AddToCart(selectedItem, "mock-student-123");
        NavigationManager.NavigateTo("/cart");
    }

    private void ViewDetails(int itemId)
    {
        NavigationManager.NavigateTo($"/item-details/{itemId}");
    }
}