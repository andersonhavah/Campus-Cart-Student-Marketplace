@page "/listings/delete/{Id:int}"
@using Campus_Cart_Student_Marketplace.Models
@inject Campus_Cart_Student_Marketplace.Services.ItemService ItemService
@inject Campus_Cart_Student_Marketplace.Services.ApplicationUserService ApplicationUserService  
@inject NavigationManager Nav

<PageTitle>Delete Listing</PageTitle>

<div class="confirm-page">

    <div class="confirm-card">

        <h1>Delete Listing</h1>

        <p>
            Are you sure you want to delete this listing?
        </p>

        <div class="actions">

            <button class="danger-btn" @onclick="DeleteListings">
                Delete Listing
            </button>

            <button class="secondary-btn" @onclick="NavigateToDashboard">
                Cancel
            </button>

        </div>

    </div>

</div>

@code {

    [Parameter]
    public int Id { get; set; }

    private Item? Item = new(); 
    private ApplicationUser? CurrentUser = new();

    protected override async Task OnInitializedAsync()
    {
        Item = ItemService.GetItemById(Id);
        CurrentUser = ApplicationUserService.GetUser(Item.SellerId);

    }


    private void DeleteListings()
    {
        var deleted = ItemService.DeleteItem(Id);
        if (deleted) {
            CurrentUser.Listings.Remove(Item.Id);
            NavigateToDashboard();
        }
        
    }

    private void NavigateToDashboard()
    {
        Nav.NavigateTo($"/dashboard");
    }
}