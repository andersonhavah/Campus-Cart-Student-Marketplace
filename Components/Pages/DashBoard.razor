@page "/dashboard"
@using Campus_Cart_Student_Marketplace.Models
@using Campus_Cart_Student_Marketplace.Components.Shared
@inject Campus_Cart_Student_Marketplace.Services.ApplicationUserService ApplicationUserService  


<PageTitle>Dashboard</PageTitle>

<div class="dashboard-container">

    <aside class="dashboard-sidebar">

        <ProfileCard User="CurrentUser" />

    </aside>

    <main class="dashboard-main">
        <DashboardStats
            ListingCount="CurrentUser.Listings.Count"
            CartCount="3"
            MessageCount="2" />

        @if(CurrentUser.Seller)
        {
            <SellerSection User="CurrentUser"/>
        }
        else
        {
            <BuyerSection />
        }

    </main>

</div>

@code {

    private ApplicationUser CurrentUser = new()
    {
        FullName = "Faith Oluwatise Idowu",
        Username = "faithidowu",
        Email = "faith@e=gmail.com",
        PhoneNumber = "+234 800 000 0000",
        Address = "Kano, Nigeria",
        Seller = true,
        Listings = new() { 1, 2, 3, 4 }
    };

    protected override async Task OnInitializedAsync()
    {
        CurrentUser = ApplicationUserService.GetUsers()[0];
    }
   
}