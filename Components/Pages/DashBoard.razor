@page "/dashboard"
@using Campus_Cart_Student_Marketplace.Models
@using Campus_Cart_Student_Marketplace.Components.Shared
@inject Campus_Cart_Student_Marketplace.Services.ApplicationUserService ApplicationUserService  
@inject Campus_Cart_Student_Marketplace.Services.CartService CartService
@inject Campus_Cart_Student_Marketplace.Services.MessageService MessageService


<PageTitle>Dashboard</PageTitle>

<div class="dashboard-container">

    <aside class="dashboard-sidebar">

        <ProfileCard User="CurrentUser" />

    </aside>

    <main class="dashboard-main">
        <DashboardStats
            ListingCount="CurrentUser.Listings.Count"
            CartCount="@CartCount"
            MessageCount="@MessageCount" />

        @if(CurrentUser.Seller)
        {
            <SellerSection User="CurrentUser"/>
        }
        else
        {
            <BuyerSection User="CurrentUser"/>
        }

    </main>

</div>

@code {

    private ApplicationUser CurrentUser = new();

    private int MessageCount = 0;

    private int CartCount = 0;

    protected override async Task OnInitializedAsync()
    {
        CurrentUser = ApplicationUserService.GetUsers()[0];
        CartCount = CartService.GetCartItems(CurrentUser.Id).Count;
        CurrentUser.Seller = true;
        if (CurrentUser.Seller == true) {
            MessageCount = MessageService.GetUserInbox(CurrentUser.Id).Count;
        } else {
            MessageCount = MessageService.GetSentMessages(CurrentUser.Id).Count;
        }
    }


   
}