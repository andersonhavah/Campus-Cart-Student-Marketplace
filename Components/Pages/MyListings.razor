@page "/my-listings"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Campus_Cart_Student_Marketplace.Models
@using Campus_Cart_Student_Marketplace.Services
@attribute [Authorize]
@inject UserManager<ApplicationUser> UserManager
@inject HttpContext HttpContext
@inject ListingService ListingService
@inject NavigationManager NavigationManager
@inject ILogger<MyListings> Logger
@inject IJSRuntime JS

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <h1>My Listings</h1>
            @if (isSellerAccount)
            {
                <a href="/create-listing" class="btn btn-success">+ Create New Listing</a>
            }
            else
            {
                <div class="alert alert-info mb-0">
                    <strong>Info:</strong> You need a seller account to list items. 
                    <a href="/account-settings">Upgrade to seller account</a>
                </div>
            }
        </div>
    </div>

    @if (listings == null)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p>Loading your listings...</p>
        </div>
    }
    else if (listings.Count == 0)
    {
        <div class="alert alert-info text-center">
            <h5>No listings yet</h5>
            <p>Start selling by creating your first listing!</p>
            @if (isSellerAccount)
            {
                <a href="/create-listing" class="btn btn-success">Create Your First Listing</a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Status</th>
                        <th>Views</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var listing in listings)
                    {
                        <tr>
                            <td>
                                <strong>@listing.Title</strong>
                                @if (!listing.IsAvailable)
                                {
                                    <span class="badge bg-danger ms-2">Sold</span>
                                }
                            </td>
                            <td>@listing.Category?.Name</td>
                            <td>$@listing.Price.ToString("F2")</td>
                            <td>
                                @if (listing.IsAvailable)
                                {
                                    <span class="badge bg-success">Available</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Unavailable</span>
                                }
                            </td>
                            <td>@listing.ViewCount</td>
                            <td>@listing.CreatedAt.ToShortDateString()</td>
                            <td>
                                <a href="/edit-listing/@listing.ListingId" class="btn btn-sm btn-primary me-2" title="Edit">
                                    ✏️ Edit
                                </a>
                                <button class="btn btn-sm btn-danger" @onclick="() => ConfirmDelete(listing.ListingId)" title="Delete">
                                    🗑️ Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<Listing>? listings;
    private ApplicationUser? currentUser;
    private bool isSellerAccount = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            currentUser = await UserManager.GetUserAsync(HttpContext.User);
            
            if (currentUser == null)
            {
                NavigationManager.NavigateTo("/login");
                return;
            }

            isSellerAccount = currentUser.IsSellerAccount;

            if (isSellerAccount)
            {
                listings = await ListingService.GetSellerListingsAsync(currentUser.Id);
                Logger.LogInformation($"Loaded {listings.Count} listings for seller {currentUser.Email}");
            }
            else
            {
                listings = new List<Listing>();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading seller listings");
            listings = new List<Listing>();
        }
    }

    private async Task ConfirmDelete(int listingId)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this listing?");
        if (confirmed)
        {
            await DeleteListing(listingId);
        }
    }

    private async Task DeleteListing(int listingId)
    {
        try
        {
            if (currentUser == null) return;

            var success = await ListingService.DeleteListingAsync(listingId, currentUser.Id);
            if (success)
            {
                listings?.RemoveAll(l => l.ListingId == listingId);
                await JS.InvokeVoidAsync("alert", "Listing deleted successfully!");
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Error deleting listing");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting listing");
            await JS.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
    }
}
