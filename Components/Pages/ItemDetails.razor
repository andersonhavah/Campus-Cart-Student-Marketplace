@page "/item/{Id:int}"
@using Campus_Cart_Student_Marketplace.Components.Shared
@using Campus_Cart_Student_Marketplace.Models
@using Campus_Cart_Student_Marketplace.Services
@inject ItemService ItemService
@inject CategoryService CategoryService
@inject CartService CartService
@inject NavigationManager Nav

@if (Item == null)
{
    <div class="container my-5 text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading marketplace item...</span>
        </div>
        <p class="text-muted mt-3">Fetching listing details from the campus hub...</p>
    </div>
}
else
{
    <PageTitle>Campus Cart - @Item.Title</PageTitle>
    <div class="main">
        <div class="item-details">

            <div class="item-details__gallery">
                <img class="main-image" src="@Item.ImageUrl" alt="@Item.Title" />
                <div class="thumbnail-list">
                    <img src="@Item.ImageUrl" alt="Thumbnail 1" />
                    <img src="@Item.ImageUrl" alt="Thumbnail 2" />
                    <img src="@Item.ImageUrl" alt="Thumbnail 3" />
                </div>
            </div>

            <div class="item-details__info">
                <span class="item-category">
                    @(CategoryService.GetCategoryById(Item.CategoryId)?.Name ?? "General Marketplace")
                </span>

                <h1>@Item.Title</h1>

                <div class="item-price">
                    $@((Item.Price / 1000.00m).ToString("N2"))
                </div>

                <p class="item-description">
                    @Item.Description
                </p>

                <div class="item-meta">
                    <div>
                        <strong>Condition</strong>
                        <span>@Item.Condition</span>
                    </div>

                    <div>
                        <strong>Location</strong>
                        <span>University Campus</span>
                    </div>

                    <div>
                        <strong>Posted</strong>
                        <span>@Item.CreatedAt.ToString("MMMM dd, yyyy")</span>
                    </div>
                </div>

                <div class="seller-card">
                    <div class="seller-avatar">
                        SD
                    </div>
                    <div>
                        <h3>Student Seller</h3>
                        <p>Verified Campus Profile</p>
                    </div>
                </div>

                <div class="details-actions">
                    <button class="primary-btn" @onclick="HandleContact">
                        Contact Seller
                    </button>

                    <button class="primary-btn" @onclick="ToCart">
                        Save Item
                    </button>
                </div>

            </div>

        </div>

        <section class="promo">
            <div class="promo__header">
                <div>
                    <h2 class="promo__title">Similar Items</h2>
                    <p class="promo__subtitle">Other items you may like.</p>
                </div>
            </div>

            <div class="promo__list">
                @if (Items == null || Items.Count <= 0)
                {
                    @for (int i = 0; i < 4; i++)
                    {
                        <Loading Text="Loading marketplace items..." />
                    }
                }
                else
                {
                    @foreach (var I in Items)
                    {
                        <ItemComponent item=@I />
                    }
                }
            </div>
        </section>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Item? Item;
    private List<Item> Items = new();

    protected override async Task OnInitializedAsync()
    {
        // Fetch item records via asynchronous tasks safely
        Item = await ItemService.GetItemByIdAsync(Id);

        if (Item != null)
        {
            var related = await ItemService.GetItemsByCategoryAsync(Item.CategoryId);
            if (related != null)
            {
                // Filter out the current item from appearing in its own "Similar Items" tray
                Items = related.Where(i => i.Id != Item.Id).Take(4).ToList();
            }
        }
    }

    public void HandleContact()
    {
        if (Item != null)
        {
            Console.WriteLine($"Initiating communication stream with seller: {Item.SellerId}");
            Nav.NavigateTo($"/contact-seller/{Id}");
        }
    }

    public async Task ToCart()
    {
        if (Item != null)
        {
            // Use static fallback buyer identifier matching your CartService mock tests
            await CartService.AddToCart(Item, "mock-student-123");
            Nav.NavigateTo("/cart");
        }
    }
}