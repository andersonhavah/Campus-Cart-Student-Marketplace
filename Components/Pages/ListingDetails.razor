@page "/listing/{listingId:int}"
@using Microsoft.AspNetCore.Identity
@using Campus_Cart_Student_Marketplace.Models
@using Campus_Cart_Student_Marketplace.Services
@inject UserManager<ApplicationUser> UserManager
@inject HttpContext HttpContext
@inject ListingService ListingService
@inject CartService CartService
@inject NavigationManager NavigationManager
@inject ILogger<ListingDetails> Logger

<div class="container mt-4">
    @if (listing == null)
    {
        <div class="text-center">
            <div class="spinner-border" role="status"></div>
            <p>Loading listing...</p>
        </div>
    }
    else if (notFound)
    {
        <div class="alert alert-warning text-center">
            <h5>Listing Not Found</h5>
            <p>The listing you're looking for doesn't exist.</p>
            <a href="/marketplace" class="btn btn-primary">Back to Marketplace</a>
        </div>
    }
    else
    {
        <div class="row">
            <!-- Image and Details -->
            <div class="col-md-6">
                @if (!string.IsNullOrEmpty(listing.ImageUrl))
                {
                    <img src="@listing.ImageUrl" alt="@listing.Title" class="img-fluid rounded shadow" style="max-height: 500px; object-fit: cover; width: 100%;" />
                }
                else
                {
                    <div class="bg-light rounded d-flex align-items-center justify-content-center" style="height: 500px;">
                        <p class="text-muted">No image available</p>
                    </div>
                }

                <div class="mt-3">
                    <p class="text-muted">
                        <small>Views: @listing.ViewCount | Listed: @listing.CreatedAt.ToShortDateString()</small>
                    </p>
                </div>
            </div>

            <!-- Listing Information -->
            <div class="col-md-6">
                <div class="card shadow">
                    <div class="card-body">
                        <h2>@listing.Title</h2>

                        <div class="mb-3">
                            <span class="badge bg-secondary">@listing.Category?.Name</span>
                            <span class="badge bg-info">@listing.Condition</span>
                            @if (!listing.IsAvailable)
                            {
                                <span class="badge bg-danger">Unavailable</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Available</span>
                            }
                        </div>

                        <div class="mb-3">
                            <h3 class="text-primary">$@listing.Price.ToString("F2")</h3>
                        </div>

                        <!-- Seller Info -->
                        <div class="card mb-3 bg-light">
                            <div class="card-body">
                                <h6 class="card-title">Seller Information</h6>
                                <p class="mb-1"><strong>Name:</strong> @listing.Seller?.StoreName</p>
                                <p class="mb-1"><strong>Email:</strong> @listing.Seller?.Email</p>
                                @if (listing.Seller?.AverageRating.HasValue ?? false)
                                {
                                    <p class="mb-0"><strong>Rating:</strong> ⭐ @listing.Seller.AverageRating.Value.ToString("F1")</p>
                                }
                            </div>
                        </div>

                        <!-- Location -->
                        @if (!string.IsNullOrEmpty(listing.Location))
                        {
                            <p class="mb-3">
                                <strong>📍 Location:</strong> @listing.Location
                            </p>
                        }

                        <!-- Action Buttons -->
                        @if (listing.IsAvailable)
                        {
                            <div class="d-grid gap-2">
                                @if (currentUser != null && currentUser.Id != listing.SellerId)
                                {
                                    <button class="btn btn-primary btn-lg" @onclick="AddToCart" disabled="@isAddingToCart">
                                        @if (isAddingToCart)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                            <span>Adding...</span>
                                        }
                                        else
                                        {
                                            <span>🛒 Add to Cart</span>
                                        }
                                    </button>
                                }
                                else if (currentUser != null && currentUser.Id == listing.SellerId)
                                {
                                    <a href="/edit-listing/@listing.ListingId" class="btn btn-primary btn-lg">✏️ Edit Listing</a>
                                }
                                else
                                {
                                    <a href="/login" class="btn btn-primary btn-lg">🔐 Login to Add to Cart</a>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Description Section -->
        <div class="row mt-4">
            <div class="col-12">
                <div class="card shadow">
                    <div class="card-header">
                        <h5 class="mb-0">Description</h5>
                    </div>
                    <div class="card-body">
                        <p>@listing.Description</p>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success alert-dismissible fade show position-fixed bottom-0 end-0 m-3">
                @successMessage
                <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public int ListingId { get; set; }

    private Listing? listing;
    private ApplicationUser? currentUser;
    private bool notFound = false;
    private bool isAddingToCart = false;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            currentUser = await UserManager.GetUserAsync(HttpContext.User);
            
            listing = await ListingService.GetListingAsync(ListingId);
            if (listing == null)
            {
                notFound = true;
                return;
            }

            // Increment view count
            await ListingService.IncrementViewCountAsync(ListingId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, $"Error loading listing {ListingId}");
            notFound = true;
        }
    }

    private async Task AddToCart()
    {
        try
        {
            if (currentUser == null)
            {
                NavigationManager.NavigateTo("/login");
                return;
            }

            if (listing == null) return;

            isAddingToCart = true;
            await CartService.AddToCartAsync(currentUser.Id, listing.ListingId, 1);
            successMessage = "Item added to cart!";
            
            await Task.Delay(2000);
            successMessage = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error adding to cart");
            successMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isAddingToCart = false;
        }
    }
}
