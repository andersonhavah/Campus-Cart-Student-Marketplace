@using Campus_Cart_Student_Marketplace.Models
@using Campus_Cart_Student_Marketplace.Services
@inject NavigationManager Nav

@inject ApplicationUserService UserService
@inject MessageService MessageService

<div class="message-card @(Message.IsRead ? "" : "unread")">

    <div class="message-header">

        <div>

            <h4>@SenderName</h4>

            <small>
                @Message.Timestamp.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")
            </small>

        </div>

        @if (!Message.IsRead)
        {
            <span class="message-badge">
                New
            </span>
        }

    </div>

    <p class="message-content">
        @Message.Content
    </p>

    <div class="message-actions">

        @if (!Message.IsRead)
        {
            <button class="btn btn-primary btn-sm"
                    @onclick="MarkAsRead">
                Mark Read
            </button>
            
        }
        |
        <button class="btn btn-danger btn-sm"
                @onclick="DeleteMessage">
            Delete
        </button>

    </div>

</div>

@code {

    [Parameter]
    public Message Message { get; set; } = default!;

    private string SenderName = "Unknown User";

    protected override void OnParametersSet()
    {
        var sender = UserService.GetUser(Message.SenderUserId);

        if (sender is not null)
        {
            SenderName = sender.Username;
        }
    }

    private void MarkAsRead()
    {
        MessageService.MarkAsRead(Message.Id);
        Reload();
    }

    private void DeleteMessage()
    {
        MessageService.DeleteMessage(Message.Id);
        Reload();
    }

    private void Reload()
    {
        Nav.Refresh(true);
    }
}