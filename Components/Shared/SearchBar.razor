@inject NavigationManager Nav

<form class="search" @onsubmit:preventDefault @onsubmit="HandleSearch">
    <input type="text"
           placeholder="Search for items..."
           @bind="searchText"
           @bind:after="HandleSearch" />   <!-- Optional: Search on Enter -->

    <button type="submit">
        <img src="/img/search.webp" alt="Search" />
    </button>
</form>

@code {
    private string searchText = string.Empty;

    private void HandleSearch()
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            // Optional: You can clear results or do nothing
            return;
        }

        Console.WriteLine($"Searching for: {searchText}");
        
        Nav.NavigateTo($"/marketplace?search={Uri.EscapeDataString(searchText.Trim())}");
    }
}